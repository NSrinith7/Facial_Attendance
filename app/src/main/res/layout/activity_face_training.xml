<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?android:attr/colorBackground"
    tools:context=".FaceTrainingActivity">

    <!-- Main content container - centered vertically and horizontally -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title / Heading -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Training Faces"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="16dp" />

        <!-- Status message (updated dynamically from code) -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing your images...\nPlease wait."
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:maxLines="4"
            android:ellipsize="end"
            android:layout_marginBottom="32dp" />

        <!-- Progress indicator -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            style="@android:style/Widget.ProgressBar.Large"
            android:indeterminate="true"
            android:layout_marginBottom="32dp" />

        <!-- Optional: Small icon or placeholder for visual feedback -->
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_face_scan"
            android:contentDescription="Face scanning"
        android:scaleType="fitCenter"
        android:layout_marginBottom="24dp" />

        <!-- Optional retry / start button (can be hidden initially) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retry"
            android:visibility="gone"
        app:cornerRadius="28dp"
        app:backgroundTint="?attr/colorPrimary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>