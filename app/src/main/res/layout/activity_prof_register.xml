<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        tools:context=".activities.ProfRegisterActivity">

        <ImageView
            android:id="@+id/img"
            android:foregroundGravity="center"
            android:layout_centerHorizontal="true"
            android:src="@drawable/p1"
            android:layout_width="100dp"
            android:layout_height="100dp" />
        <TextView
            android:id="@+id/tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Professor Registration"
            android:textStyle="bold"
            android:layout_below="@+id/img"
            android:layout_margin="10dp"
            android:layout_centerHorizontal="true"
            android:textSize="20dp"
            android:gravity="center"/>

        <EditText
            android:layout_below="@+id/tv"
            android:id="@+id/et_name"
            android:singleLine="true"
            android:layout_margin="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:hint="Name"
            android:textSize="19sp"
            />


        <EditText
            android:layout_below="@+id/et_name"
            android:id="@+id/et_email"
            android:singleLine="true"
            android:layout_margin="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:hint="Email"
            android:textSize="19sp"
            />

        <EditText
            android:layout_below="@+id/et_email"
            android:id="@+id/et_phone"
            android:singleLine="true"
            android:inputType="number"
            android:layout_margin="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:hint="Phone"
            android:textSize="19sp"
            />


        <EditText
            android:id="@+id/et_password"
            android:singleLine="true"
            android:backgroundTint="@color/colorPrimaryDark"
            android:layout_margin="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/et_phone"
            android:hint="Password"
            android:inputType="textPassword"
            android:textSize="19sp"
            />



        <EditText
            android:layout_below="@+id/et_password"
            android:id="@+id/et_designation"
            android:singleLine="true"
            android:layout_margin="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:hint="Designation"
            android:textSize="19sp"
            />

        <Button
            android:id="@+id/register_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/et_designation"
            android:layout_alignParentRight="true"
            android:gravity="center"
            android:layout_margin="20dp"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:text="Register"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_reg"
            android:layout_below="@+id/register_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:text="Have account ?"
            android:textColor="#111111"
            android:textSize="19sp"
            />

        <TextView
            android:id="@+id/tv_profLogin"
            android:layout_below="@+id/register_btn"
            android:layout_toRightOf="@+id/tv_reg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="signIn"
            android:fontFamily="sans-serif-black"
            android:textColor="#000"
            android:textSize="19sp" />




    </RelativeLayout>
</ScrollView>